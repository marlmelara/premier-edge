# --- Database (Neon in prod, Docker Compose locally) ---
DATABASE_URL=postgres://premier:premier@localhost:5432/premier_edge

# --- Auth.js ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# JSON array of the two allowed users. Generate an entry (already $-escaped) with:
#   node -e "console.log(JSON.stringify([{email:'you@example.com',name:'You',passwordHash:require('bcryptjs').hashSync(process.argv[1],10)}]).replace(/\$/g,'\\\$'))" 'your-password'
# IMPORTANT: every `$` in a bcrypt hash must be escaped as `\$` here, or dotenv
# eats part of the hash and logins fail. Startup validates the shape and says so.
AUTH_USERS=[{"email":"marlon@example.com","name":"Marlon","passwordHash":"\$2b\$10\$..."}]

# --- Sendivo (transport only) --- open item #1: key + webhook token
SENDIVO_API_KEY=
SENDIVO_WEBHOOK_TOKEN=

# --- Upstash Redis (used from M1: check cache, send-locks) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- SignWell (M4) --- open item #2
SIGNWELL_API_KEY=
# Webhook secret id from SignWell's dashboard (API > Webhooks). Doubles as the
# HMAC key: signature = HMAC-SHA256(webhook_id, "{type}@{time}").
SIGNWELL_WEBHOOK_ID=
SIGNWELL_PSA_TEMPLATE_ID=
SIGNWELL_PSA_SELLER_ROLE=Seller
SIGNWELL_ASSIGNMENT_TEMPLATE_ID=
SIGNWELL_ASSIGNMENT_BUYER_ROLE=Assignee
# Set to "true" while testing so SignWell doesn't bill or legally bind
SIGNWELL_TEST_MODE=true

# --- Title email (M4) ---
RESEND_API_KEY=
TITLE_EMAIL_FROM=marlon@premierequity.example

# --- Anthropic (M3, language only) ---
ANTHROPIC_API_KEY=

# --- Notifications (§11b) --- Marlon's cell, E.164
MARLON_PHONE=
